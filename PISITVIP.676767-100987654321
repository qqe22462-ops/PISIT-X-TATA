-- ====================================================================
-- 1. ระบบตรวจสอบความปลอดภัยขั้นเด็ดขาด (รันเช็คเป็นอันดับแรกสุด)
-- ====================================================================
local function instantKickAndStop(reason)
    pcall(function()
        -- เตะออกจากเกมทันที
        localPlayer:Kick("\n🚫 PISIT HUB SECURITY 🚫\n\nตรวจพบเครื่องมือเจาะระบบหรือ HttpSpy!\nระบบไม่อนุญาตให้ใช้งาน\nเหตุผล: " .. tostring(reason))
    end)
    -- หยุดการทำงานของเธรดปัจจุบันทันที ไม่ให้โค้ดข้างล่างรันต่อ
    task.cancel(coroutine.running())
end

-- ตรวจสอบการมีอยู่ของ HttpSpy หรือเครื่องมือสปายก่อนรันระบบหลัก
pcall(function()
    if CoreGui:FindFirstChild("HttpSpy") or 
       CoreGui:FindFirstChild("SimpleSpy") or 
       CoreGui:FindFirstChild("Dex") or 
       CoreGui:FindFirstChild("Dark Dex") or 
       CoreGui:FindFirstChild("Hydroxide") or
       localPlayer.PlayerGui:FindFirstChild("HttpSpy") or 
       localPlayer.PlayerGui:FindFirstChild("SimpleSpy") then
        instantKickAndStop("Forbidden Spy Tool Detected on Startup")
    end
end)

