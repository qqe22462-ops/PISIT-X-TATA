-- ====================================================================
-- PISIT x TATA | Main Hub UI (Cloudflare Backend Secure Guard)
-- ====================================================================

-- โหลด UI หลัก
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/qqe22462-ops/PISIT-X-TATA/refs/heads/main/PISIT_HUB.bundle.lua"))()

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local localPlayer = Players.LocalPlayer

-- ดึงข้อมูลชื่อแมพปัจจุบัน
local success, placeInfo = pcall(function()
    return MarketplaceService:GetProductInfo(game.PlaceId)
end)
local mapName = success and placeInfo.Name or "Unknown Map"

-- ตัวแปรเก็บจำนวนคนรัน (รับมาจาก Cloudflare หลังบ้าน)
local totalUniqueUsers = 0

-- ====================================================================
-- ส่งข้อมูลไปให้ Cloudflare จัดการเรื่อง Cooldown และ Counter 
-- ====================================================================
task.spawn(function()
    pcall(function()
        local workerUrl = "https://asasaafafe.qqe22462.workers.dev/"

        local data = {
            username = localPlayer.Name,
            userId = localPlayer.UserId,
            mapName = mapName,
            placeId = game.PlaceId
        }

        local encodedData = HttpService:JSONEncode(data)
        local httpRequest = request or http_request or syn and syn.request
        
        if httpRequest then
            local response = httpRequest({
                Url = workerUrl,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = encodedData
            })

            -- ถ้าหลังบ้านตอบกลับมาสำเร็จ ให้ดึงยอดคนรันสะสมมาเก็บไว้
            if response and response.StatusCode == 200 then
                local decodedRes = HttpService:JSONDecode(response.Body)
                if decodedRes and decodedRes.totalUniqueUsers then
                    totalUniqueUsers = decodedRes.totalUniqueUsers
                end
            end
        end
    end)
end)

-- ดาวน์โหลดและรันไฟล์เสียง pisit.mp3
task.spawn(function()
    pcall(function()
        local soundFileName = "pisit.mp3"
        local soundRawLink = "https://raw.githubusercontent.com/qqe22462-ops/PISIT-X-TATA/refs/heads/main/pisit.mp3"

        if not isfile(soundFileName) then
            writefile(soundFileName, game:HttpGet(soundRawLink))
        end

        local sound = Instance.new("Sound")
        sound.SoundId = getcustomasset(soundFileName)
        sound.Volume = 2
        sound.Parent = workspace
        sound:Play()

        task.delay(10, function()
            if sound then sound:Destroy() end
        end)
    end)
end)

-- สร้างหน้าต่างหลักของโปรเจกต์
local Window = Library:CreateWindow({
    Title = "PISIT x TATA | Main Hub"
})

-- สร้าง Tabs
local PlayerTab = Window:CreateTab({ Title = "Player" })
local CheatTab = Window:CreateTab({ Title = "ช่วยเล่น" })
local MapTab = Window:CreateTab({ Title = "สคริปต์ของแมพ: " .. mapName })
local SettingTab = Window:CreateTab({ Title = "Setting" })

-- สร้าง Sections
local EspSection = PlayerTab:CreateSection({ Title = "Visuals (ESP)" })
local OptSection = PlayerTab:CreateSection({ Title = "Optimization & Performance" })
local CheatSection = CheatTab:CreateSection({ Title = "Script Executor Helper" })
local MapScriptSection = MapTab:CreateSection({ Title = "ระบบตรวจสอบและรันสคริปต์ประจำแมพ" })

-- Sections ในหน้า Setting
local ProfileSection = SettingTab:CreateSection({ Title = "ข้อมูลผู้ใช้งานและแมพ" })
local StatsSection = SettingTab:CreateSection({ Title = "สถิติการใช้งานสคริปต์" })

-- ====================================================================
-- SETTING TAB: ข้อมูลผู้รันและสถิติต่างๆ
-- ====================================================================
ProfileSection:CreateButton({
    Title = "👤 ชื่อผู้รัน " .. localPlayer.Name .. " (ID: " .. localPlayer.UserId .. ")",
    Callback = function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "PISIT HUB - Profile",
            Text = "คุณกำลังใช้งานในชื่อ " .. localPlayer.Name,
            Duration = 2
        })
    end
})

ProfileSection:CreateButton({
    Title = "🗺️ แมพปัจจุบัน " .. mapName .. " (ID: " .. game.PlaceId .. ")",
    Callback = function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "PISIT HUB - Map Info",
            Text = "PlaceId: " .. game.PlaceId,
            Duration = 2
        })
    end
})

StatsSection:CreateButton({
    Title = "📊 จำนวนคนรันสคริปต์ทั้งหมดไม่ซ้ำคน " .. totalUniqueUsers .. " คน",
    Callback = function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "PISIT HUB - Stats",
            Text = "มีผู้ใช้งานไม่ซ้ำไอดีรันสคริปต์นี้ไปแล้ว " .. totalUniqueUsers .. " คน!",
            Duration = 3
        })
    end
})

-- ====================================================================
-- PLAYER TAB: ESP ค่าย PISIT หลัก
-- ====================================================================
EspSection:CreateToggle({
    Title = "ESP ค่าย PISIT หลัก",
    Default = false,
    Callback = function(state)
        if state then
            pcall(function()
                if getgenv and getgenv().PisitEspCleanup then
                    getgenv().PisitEspCleanup()
                end
            end)
            
            task.spawn(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/qqe22462-ops/PISIT-X-TATA/refs/heads/main/ESP.PISIT.HUB"))()
            end)
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "PISIT HUB",
                Text = "เปิด ESP ค่าย PISIT สำเร็จ",
                Duration = 2
            })
        else
            pcall(function()
                if getgenv and getgenv().PisitEspCleanup then
                    getgenv().PisitEspCleanup()
                end
            end)
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "PISIT HUB",
                Text = "ปิดและเคลียร์เส้น ESP ทั้งหมดแล้ว",
                Duration = 2
            })
        end
    end
})

