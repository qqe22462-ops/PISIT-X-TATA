-- ====================================================================
-- MAP TAB: ระบบตรวจสอบแมพและแสดงปุ่มรันสคริปต์เฉพาะแมพ
-- ====================================================================
if string.find(string.lower(mapName), "strongest") or game.PlaceId == 10449761463 or game.PlaceId == 2534724415 then
    MapScriptSection:CreateButton({
        Title = "⚡ รันสคริปต์แมพ The Strongest Battlegrounds",
        Callback = function()
            task.spawn(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/qqe22462-ops/PISIT-X-TATA/refs/heads/main/TSB.PISIT"))()
            end)
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "PISIT HUB - MAP",
                Text = "กำลังรันสคริปต์สำหรับ The Strongest Battlegrounds...",
                Duration = 3
            })
        end
    })
else
    MapScriptSection:CreateButton({
        Title = "📌 แมพปัจจุบัน " .. mapName .. " (ยังไม่มีสคริปต์เฉพาะแมพนี้)",
        Callback = function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "PISIT HUB",
                Text = "แมพนี้ยังไม่มีสคริปต์พิเศษรองรับเพื่อน!",
