-- ====================================================================
-- PISIT HUB | 3D Box ESP (Optimized Smooth Red-Black Theme with Toggle Support)
-- ====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- ป้องกันรันซ้ำซ้อน: ถ้ามีตัวเก่าค้างอยู่ ให้สั่งปิดและเคลียร์ทิ้งก่อนทันที
if getgenv().PisitEspCleanup then
    getgenv().PisitEspCleanup()
end

local boxes = {}
local isRunning = true

-- ฟังก์ชันสร้างกล่อง 3 มิติ (12 เส้น)
local function createBox()
    local boxLines = {}
    for i = 1, 12 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1.8
        line.Transparency = 1
        table.insert(boxLines, line)
    end
    return boxLines
end

-- ฟังก์ชันลบเส้นและทำลาย Drawing ทิ้งทั้งหมด
local function removeBox(boxLines)
    for _, line in ipairs(boxLines) do
        line:Remove()
    end
end

-- ฟังก์ชันเคลียร์ระบบทั้งหมด (ใช้สำหรับสั่งปิดตัว ESP ออกจากเกมแบบเกลี้ยงๆ)
local cleanupFunc = function()
    isRunning = false
    for player, boxLines in pairs(boxes) do
        removeBox(boxLines)
    end
    table.clear(boxes)
    if getgenv().PisitEspCleanup == cleanupFunc then
        getgenv().PisitEspCleanup = nil
    end
end

getgenv().PisitEspCleanup = cleanupFunc

-- เชื่อมต่อลูป RenderStepped
local renderConnection
renderConnection = RunService.RenderStepped:Connect(function()
    if not isRunning then
        if renderConnection then
            renderConnection:Disconnect()
        end
        return
    end

    local activePlayers = Players:GetPlayers()
    
    for _, player in ipairs(activePlayers) do
        if player ~= LocalPlayer then
            if not boxes[player] then
                boxes[player] = createBox()
            end
            
            local boxLines = boxes[player]
            local character = player.Character
            local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChild("Humanoid")
            
            if character and humanoidRootPart and humanoid and humanoid.Health > 0 then
                if player.Team ~= LocalPlayer.Team or not LocalPlayer.Team then
                    local cf = humanoidRootPart.CFrame
                    local size = Vector3.new(3.4, 5.4, 3.4)
                    
                    local corners = {
                        cf * CFrame.new(-size.X, size.Y, -size.Z),
                        cf * CFrame.new(size.X, size.Y, -size.Z),
                        cf * CFrame.new(size.X, size.Y, size.Z),
                        cf * CFrame.new(-size.X, size.Y, size.Z),
                        cf * CFrame.new(-size.X, -size.Y, -size.Z),
                        cf * CFrame.new(size.X, -size.Y, -size.Z),
                        cf * CFrame.new(size.X, -size.Y, size.Z),
                        cf * CGrade and cf * CFrame.new(-size.X, -size.Y, size.Z) or cf * CFrame.new(-size.X, -size.Y, size.Z)
                    }
                    -- ใช้มุมคำนวณแบบมาตรฐานเดิม
                    corners = {
                        cf * CFrame.new(-size.X, size.Y, -size.Z),
                        cf * CFrame.new(size.X, size.Y, -size.Z),
                        cf * CFrame.new(size.X, size.Y, size.Z),
                        cf * CFrame.new(-size.X, size.Y, size.Z),
                        cf * CFrame.new(-size.X, -size.Y, -size.Z),
                        cf * CFrame.new(size.X, -size.Y, -size.Z),
                        cf * CFrame.new(size.X, -size.Y, size.Z),
                        cf * CFrame.new(-size.X, -size.Y, size.Z)
                    }
                    
                    local screenPoints = {}
                    local allVisible = true
                    
                    for i, corner in ipairs(corners) do
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(corner.Position)
                        if not onScreen then
                            allVisible = false
                            break
                        end
                        screenPoints[i] = Vector2.new(screenPoint.X, screenPoint.Y)
                    end
                    
                    if allVisible then
                        local connections = {
                            {1,2}, {2,3}, {3,4}, {4,1},
                            {5,6}, {6,7}, {7,8}, {8,5},
                            {1,5}, {2,6}, {3,7}, {4,8}
                        }
                        
                        for i, conn in ipairs(connections) do
                            local line = boxLines[i]
                            if line then
                                line.From = screenPoints[conn[1]]
                                line.To = screenPoints[conn[2]]
                                
                                if i % 2 == 0 then
                                    line.Color = Color3.fromRGB(255, 20, 20)
                                else
                                    line.Color = Color3.fromRGB(10, 10, 10)
                                end
                                line.Visible = true
                            end
                        end
                    else
                        for _, line in ipairs(boxLines) do
                            line.Visible = false
                        end
                    end
                else
                    for _, line in ipairs(boxLines) do
                        line.Visible = false
                    end
                end
            else
                for _, line in ipairs(boxLines) do
                    line.Visible = false
                end
            end
        end
    end
end)

-- จัดการเคลียร์เมมโมรี่เมื่อผู้เล่นออกเกม
Players.PlayerRemoving:Connect(function(player)
    if boxes[player] then
        removeBox(boxes[player])
        boxes[player] = nil
    end
end)
